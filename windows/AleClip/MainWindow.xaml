<Window x:Class="AleClip.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AleClip"
        Height="280" Width="880"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        KeyDown="Window_KeyDown"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <Style x:Key="FilterChipStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="#252528"/>
            <Setter Property="Foreground" Value="#A0A0A0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="12" 
                                Padding="{TemplateBinding Padding}" 
                                Cursor="Hand">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Container -->
    <Border CornerRadius="16" Background="#18181B" BorderBrush="#3F3F46" BorderThickness="1">
        <Grid>
            <!-- Background Watermark ALE (Centered, 70% height, low opacity) -->
            <TextBlock Text="ALE" 
                       FontFamily="Segoe UI, Arial, sans-serif" 
                       FontWeight="Black" 
                       FontSize="160" 
                       Foreground="#FFFFFF" 
                       Opacity="0.05" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       IsHitTestVisible="False"/>

            <!-- Foreground Content Layout -->
            <Grid Margin="16,12,16,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header: Search + Filter Chips -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Box -->
                    <Border Grid.Column="0" Background="#27272A" CornerRadius="8" Padding="6,4">
                        <Grid>
                            <TextBlock x:Name="SearchPlaceholder" 
                                       Text="Search clips..." 
                                       Foreground="#71717A" 
                                       FontSize="12" 
                                       VerticalAlignment="Center" 
                                       Margin="4,0,0,0" 
                                       IsHitTestVisible="False"/>
                            <TextBox x:Name="SearchTextBox" 
                                     Background="Transparent" 
                                     BorderThickness="0" 
                                     Foreground="#FAFAFA" 
                                     FontSize="12" 
                                     VerticalAlignment="Center" 
                                     Margin="4,0,0,0" 
                                     TextChanged="SearchTextBox_TextChanged"/>
                        </Grid>
                    </Border>

                    <!-- Filter Chips -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <RadioButton x:Name="ChipAll" Content="All" Style="{StaticResource FilterChipStyle}" IsChecked="True" Checked="Filter_Checked"/>
                        <RadioButton x:Name="ChipPinned" Content="Pinned" Style="{StaticResource FilterChipStyle}" Checked="Filter_Checked"/>
                        <RadioButton x:Name="ChipText" Content="Text" Style="{StaticResource FilterChipStyle}" Checked="Filter_Checked"/>
                        <RadioButton x:Name="ChipLinks" Content="Links" Style="{StaticResource FilterChipStyle}" Checked="Filter_Checked"/>
                        <RadioButton x:Name="ChipImages" Content="Images" Style="{StaticResource FilterChipStyle}" Checked="Filter_Checked"/>
                        <RadioButton x:Name="ChipFiles" Content="Files" Style="{StaticResource FilterChipStyle}" Checked="Filter_Checked"/>
                        <RadioButton x:Name="ChipColors" Content="Colors" Style="{StaticResource FilterChipStyle}" Checked="Filter_Checked"/>
                    </StackPanel>
                </Grid>

                <!-- Center: Cards ScrollView -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="CardsPanel" Orientation="Horizontal"/>
                </ScrollViewer>

                <!-- Empty State Message -->
                <TextBlock x:Name="EmptyStateText" 
                           Grid.Row="1" 
                           Text="No clips yet. Copy something to start." 
                           Foreground="#71717A" 
                           FontSize="14" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           Visibility="Collapsed"/>

                <!-- Footer: Shortcuts Legend -->
                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="← →" Foreground="#3B82F6" FontWeight="Bold" FontSize="11" Margin="0,0,4,0"/>
                        <TextBlock x:Name="FooterNavigate" Text="Navigate" Foreground="#71717A" FontSize="11" Margin="0,0,14,0"/>

                        <TextBlock Text="↵" Foreground="#3B82F6" FontWeight="Bold" FontSize="11" Margin="0,0,4,0"/>
                        <TextBlock x:Name="FooterPaste" Text="Paste" Foreground="#71717A" FontSize="11" Margin="0,0,14,0"/>

                        <TextBlock Text="⇧↵" Foreground="#3B82F6" FontWeight="Bold" FontSize="11" Margin="0,0,4,0"/>
                        <TextBlock x:Name="FooterPlainText" Text="Plain Text" Foreground="#71717A" FontSize="11" Margin="0,0,14,0"/>

                        <TextBlock Text="Space" Foreground="#3B82F6" FontWeight="Bold" FontSize="11" Margin="0,0,4,0"/>
                        <TextBlock x:Name="FooterPreview" Text="Preview" Foreground="#71717A" FontSize="11" Margin="0,0,14,0"/>

                        <TextBlock Text="Del" Foreground="#EF4444" FontWeight="Bold" FontSize="11" Margin="0,0,4,0"/>
                        <TextBlock x:Name="FooterDelete" Text="Delete" Foreground="#71717A" FontSize="11" Margin="0,0,14,0"/>

                        <TextBlock Text="Esc" Foreground="#A1A1AA" FontWeight="Bold" FontSize="11" Margin="0,0,4,0"/>
                        <TextBlock x:Name="FooterClose" Text="Close" Foreground="#71717A" FontSize="11"/>
                    </StackPanel>

                    <TextBlock x:Name="FooterCount" Text="0 clips" Foreground="#71717A" FontSize="11" HorizontalAlignment="Right"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
