<Window x:Class="AleClip.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AleClip Settings"
        Height="480" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#18181B"
        Foreground="#FAFAFA">

    <Grid Margin="16">
        <TabControl Background="#27272A" BorderBrush="#3F3F46" Foreground="#FAFAFA">
            
            <!-- Tab 1: General -->
            <TabItem x:Name="TabGeneral" Header="General">
                <ScrollViewer Margin="16">
                    <StackPanel>
                        <!-- Language Card -->
                        <Border Background="#1F1F23" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock x:Name="LangHeader" Text="Language / Dil" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                                <ComboBox x:Name="LanguageCombo" Width="220" HorizontalAlignment="Left" SelectionChanged="LanguageCombo_SelectionChanged">
                                    <ComboBoxItem Content="System (follow Windows)" Tag="system"/>
                                    <ComboBoxItem Content="English" Tag="en"/>
                                    <ComboBoxItem Content="Türkçe" Tag="tr"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <!-- History Limits Card -->
                        <Border Background="#1F1F23" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock x:Name="HistoryHeader" Text="History Limits" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock x:Name="HistoryLimitLabel" Text="Maximum items stored: 200" Foreground="#A1A1AA" FontSize="12"/>
                                </DockPanel>
                                <Slider x:Name="HistorySlider" Minimum="50" Maximum="1000" Value="200" TickFrequency="50" IsSnapToTickEnabled="True" ValueChanged="HistorySlider_ValueChanged"/>
                            </StackPanel>
                        </Border>

                        <!-- Paste Behavior Card -->
                        <Border Background="#1F1F23" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <TextBlock x:Name="PasteBehaviorHeader" Text="Paste Behavior" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                                <CheckBox x:Name="PasteDirectlyCheck" Content="Paste directly into active application upon selection" 
                                          Foreground="#FAFAFA" IsChecked="True" Checked="PasteDirectlyCheck_Changed" Unchecked="PasteDirectlyCheck_Changed"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: Shortcuts -->
            <TabItem x:Name="TabShortcuts" Header="Shortcuts">
                <ScrollViewer Margin="16">
                    <StackPanel>
                        <Border Background="#1F1F23" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Global Hotkey" FontWeight="Bold" FontSize="13" Margin="0,0,0,4"/>
                                <TextBlock Text="Press Alt + V to toggle the AleClip panel anytime from any app." Foreground="#A1A1AA" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#1F1F23" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <TextBlock Text="In-Panel Keyboard Shortcuts" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                                <TextBlock Text="• ← → : Navigate between cards" Foreground="#A1A1AA" FontSize="12" Margin="0,2"/>
                                <TextBlock Text="• Enter : Paste selected clip" Foreground="#A1A1AA" FontSize="12" Margin="0,2"/>
                                <TextBlock Text="• Shift + Enter : Paste as plain text" Foreground="#A1A1AA" FontSize="12" Margin="0,2"/>
                                <TextBlock Text="• Space : Quick Look enlarged preview" Foreground="#A1A1AA" FontSize="12" Margin="0,2"/>
                                <TextBlock Text="• Delete : Delete clip from history" Foreground="#A1A1AA" FontSize="12" Margin="0,2"/>
                                <TextBlock Text="• Escape : Dismiss panel without pasting" Foreground="#A1A1AA" FontSize="12" Margin="0,2"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 3: Backup & Restore -->
            <TabItem x:Name="TabBackup" Header="Backup">
                <ScrollViewer Margin="16">
                    <StackPanel>
                        <Border Background="#1F1F23" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Export &amp; Restore" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                                <TextBlock Text="Export your clipboard history as a standard JSON file, or restore from a previous backup." Foreground="#A1A1AA" FontSize="12" Margin="0,0,0,12"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="ExportBtn" Content="Export History..." Width="130" Height="28" Margin="0,0,10,0" Click="ExportBtn_Click"/>
                                    <Button x:Name="ImportBtn" Content="Import History..." Width="130" Height="28" Click="ImportBtn_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="#1F1F23" CornerRadius="8" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Manage History" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
                                <TextBlock Text="Clear all unpinned clips from the database. Pinned clips are always preserved." Foreground="#A1A1AA" FontSize="12" Margin="0,0,0,12"/>
                                <Button x:Name="ClearUnpinnedBtn" Content="Clear All Unpinned Clips" Width="180" Height="28" Background="#DC2626" Foreground="White" HorizontalAlignment="Left" Click="ClearUnpinnedBtn_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
