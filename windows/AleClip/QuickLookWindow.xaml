<Window x:Class="AleClip.QuickLookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick Look"
        Height="400" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#18181B"
        Foreground="#FAFAFA"
        KeyDown="Window_KeyDown">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="HeaderTitle" FontSize="14" FontWeight="Bold" Foreground="#FAFAFA" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <!-- Content Area -->
        <Border Grid.Row="1" Background="#27272A" CornerRadius="8" Padding="12">
            <TextBox x:Name="ContentTextBox" 
                     Background="Transparent" 
                     BorderThickness="0" 
                     Foreground="#FAFAFA" 
                     FontFamily="Consolas, Cascadia Code, Courier New" 
                     FontSize="12" 
                     IsReadOnly="True" 
                     TextWrapping="Wrap" 
                     VerticalScrollBarVisibility="Auto"/>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock x:Name="StatsText" Text="0 characters" Foreground="#71717A" FontSize="11" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CopyBtn" Content="Copy" Width="80" Height="28" Margin="0,0,8,0" Click="CopyBtn_Click"/>
                <Button x:Name="PasteBtn" Content="Paste into App" Width="110" Height="28" Background="#3B82F6" Foreground="White" Click="PasteBtn_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
