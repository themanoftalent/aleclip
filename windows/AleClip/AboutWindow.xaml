<Window x:Class="AleClip.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About AleClip"
        Height="300" Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#18181B"
        Foreground="#FAFAFA">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Image Grid.Row="0" Source="Resources/app.ico" Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,10"/>
        
        <TextBlock x:Name="TitleText" Grid.Row="1" Text="AleClip" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,2"/>
        <TextBlock x:Name="VersionText" Grid.Row="2" Text="Version 1.0.0" FontSize="11" Foreground="#A1A1AA" HorizontalAlignment="Center" Margin="0,0,0,8"/>
        
        <TextBlock x:Name="TaglineText" Grid.Row="3" Text="A modern, lightweight native clipboard manager for Windows." 
                   FontSize="12" Foreground="#A1A1AA" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,14"/>

        <Border Grid.Row="4" Background="#27272A" CornerRadius="8" Padding="12,10" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock x:Name="DevelopedByText" Text="Developed by SoftAI Yazılım" FontWeight="SemiBold" FontSize="12" Foreground="#3B82F6" HorizontalAlignment="Center"/>
                <TextBlock Text="Mehmet Akif Çifçi • MIT License" FontSize="11" Foreground="#71717A" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                <TextBlock Text="Zero Data Collection • 100% Local Storage" FontSize="10" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <Button x:Name="CloseButton" Grid.Row="5" Content="Close" Width="90" Height="28" HorizontalAlignment="Center" Margin="0,14,0,0" Click="CloseButton_Click"/>
    </Grid>
</Window>
